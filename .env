# Environment: development locally; production hosting must use PostgreSQL.
APP_ENV=development

# Local SQLite development fallback
DATABASE_URL=sqlite:///./lyka_realty.db
# Local PostgreSQL: replace placeholders with your local database details
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Authentication
JWT_SECRET=02a9iLYsqXgBd0mcr62Vy1dEIREQK2VDOw4MwcueVM4Q9dTitbW6Yev8MhoLruok
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
# Recommended local mode: no cloud API key or provider quota required.
# Install Ollama and run: ollama pull qwen2.5:3b
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
# Optional cloud fallbacks. These can still have quotas/availability limits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Server & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
HOST=0.0.0.0
PORT=8000
